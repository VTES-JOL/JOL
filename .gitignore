*.class
.idea/*
*.iml
target/*
.DS_Store

# Vim
*.swp
*.swo

# Game data
src/test/resources/data/cards/*-beta.csv
src/test/resources/game*
src/test/resources/global_chat.txt
src/test/resources/data/metrics/*
images/*
static/*
csv/*
# ...but the two core VEKN card CSVs are the source of truth CardRegistry
# loads at startup (and CardRegistryTest/CardSearchServiceTest/
# DeckImportServiceTest read from csv/core/ directly) — keep them tracked so
# CI has them without a local-only manual copy step.
!csv/core/
csv/core/*
!csv/core/vtescrypt.csv
!csv/core/vteslib.csv
aws/*

# Environmental
.local-docker-compose.yml
.keys
.env
.

# Certs
*.pem
# ...except the committed non-secret dev keypair the access-token signer
# (net.deckserver.services.TokenService) falls back to when JWT_PRIVATE_KEY_FILE
# / JWT_PUBLIC_KEY_FILE are unset, so tests and a fresh checkout need no setup.
# Prod supplies its own keypair via those env vars.
!src/main/resources/jwt/jwt-dev-private.pem
!src/main/resources/jwt/jwt-dev-public.pem

# Dev-only self-signed HTTPS keystore (see application.properties's comment
# for the keytool command that regenerates it)
src/main/resources/dev-keystore.p12