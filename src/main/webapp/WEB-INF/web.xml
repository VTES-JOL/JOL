<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://java.sun.com/xml/ns/javaee"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
		  http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

    <display-name>V:TES Online</display-name>
    <description>Vtes Online Web Client</description>

    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/css/*</url-pattern>
        <url-pattern>/fonts/*</url-pattern>
        <url-pattern>/images/*</url-pattern>
        <url-pattern>/sw.js</url-pattern>
        <!--
          Explicit mapping so /react/* (the built React app's static assets,
          staged into the WAR root by maven-war-plugin from target/react-dist)
          is always served as a file, not treated as unmapped. Nothing else
          claims "/" or "/react/*" — every top-level view route is rewritten
          to /react/index.html by the RewriteValve (see context.xml and
          rewrite.config) before dispatch reaches servlet mapping at all, and
          those rewrite rules deliberately exclude /react/* itself. Local dev
          never hits either mechanism because Vite intercepts every
          React-owned path itself and never lets these requests reach Tomcat.
        -->
        <url-pattern>/react/*</url-pattern>
    </servlet-mapping>

    <!--
      No welcome-file-list: the RewriteValve's "^/$" rule already rewrites
      the context root to /react/index.html before servlet mapping runs, so
      a welcome-file here would be redundant. There's no auth gate anywhere
      in that path anymore — see AuthGate (frontend/src/App.tsx) for where
      "should this visitor see the login page or the app" is now decided.
    -->

</web-app>
