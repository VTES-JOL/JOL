<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://java.sun.com/xml/ns/javaee"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
		  http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

    <display-name>V:TES Online</display-name>
    <description>Vtes Online Web Client</description>

    <servlet>
        <servlet-name>help</servlet-name>
        <jsp-file>/WEB-INF/help.jsp</jsp-file>
    </servlet>

    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/css/*</url-pattern>
        <url-pattern>/js/*</url-pattern>
        <url-pattern>/fonts/*</url-pattern>
        <url-pattern>/images/*</url-pattern>
        <url-pattern>/sw.js</url-pattern>
        <!--
          MainServlet's url-pattern "/" makes it the servlet-spec "default
          servlet" for anything not otherwise mapped — without this entry,
          /react/* (the built React app's static assets, staged into the WAR
          root by maven-war-plugin from target/react-dist) falls through to
          MainServlet instead of being served as a file, which forwards back
          to /react/index.html and recurses into itself (StackOverflowError).
          Local dev never hit this because Vite intercepts every React-owned
          path itself and never lets these requests reach Tomcat.
        -->
        <url-pattern>/react/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>help</servlet-name>
        <url-pattern>/help</url-pattern>
    </servlet-mapping>

    <!--
      No welcome-file-list: MainServlet's exact "/" mapping already handles
      the context root (servlet-spec exact mappings take precedence over
      welcome-file resolution), so a welcome-file here was already dead
      weight even before login.jsp — which it pointed at — was deleted in
      favor of the React login page (LoginServlet forwards "/login" to
      /react/index.html directly).
    -->

</web-app>
