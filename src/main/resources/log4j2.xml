<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Properties>
        <Property name="data" value="${env:JOL_DATA:-target}"/>
    </Properties>

    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <ThresholdFilter level="INFO"/>
            <PatternLayout pattern="%d %-5p %c{1} - %m%n"/>
        </Console>
        <RollingFile name="metrics" filePattern="${data}/metrics/%d{yyyy-MM}/%d{yyyy-MM-dd}.log" append="true">
            <ThresholdFilter level="DEBUG"/>
            <CsvParameterLayout quoteMode="NON_NUMERIC"/>
            <TimeBasedTriggeringPolicy/>
        </RollingFile>
        <RollingFile name="commands" filePattern="${data}/commands/%d{yyyy-MM}/%d{yyyy-MM-dd}.log" append="true">
            <ThresholdFilter level="INFO"/>
            <TimeBasedTriggeringPolicy/>
        </RollingFile>
        <Routing name="commands">
            <Routes pattern="$${ctx:DYNAMIC_LOG}">
                <Route>
                    <File name="routing_log" append="true" fileName="${data}/commands/${ctx:DYNAMIC_LOG}.log">
                        <PatternLayout pattern="%d{ISO8601} %-5p %m%n"/>
                    </File>
                </Route>
            </Routes>
        </Routing>
    </Appenders>

    <!--
      No Root logger here: this file only governs log4j2's own
      LoggerContext, which only net.deckserver.metrics/commands below ever
      reach — GameModel obtains those two via org.apache.logging.log4j's
      native LogManager (not SLF4J), specifically to get the per-game
      dynamic file routing below (Quarkus's own logging has no equivalent
      for that). Every other class logs via SLF4J, which Quarkus's own
      org.jboss.slf4j:slf4j-jboss-logmanager binding wins over this file's
      log4j-slf4j2-impl for — so a Root logger/console appender here would
      never actually be reached by app code. See application.properties'
      quarkus.log.console.format for that logging's equivalent config.
    -->
    <Loggers>
        <Logger name="net.deckserver.metrics" level="INFO" additivity="false">
            <AppenderRef ref="metrics"/>
        </Logger>
        <Logger name="net.deckserver.commands" level="INFO" additivity="false">
            <AppenderRef ref="commands"/>
            <AppenderRef ref="console" level="error"/>
        </Logger>
    </Loggers>

</Configuration>