<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Properties>
        <Property name="data" value="${env:JOL_DATA:-target}"/>
    </Properties>

    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <ThresholdFilter level="INFO"/>
            <PatternLayout pattern="%d %-5p %c{1} - %m%n"/>
        </Console>
        <RollingFile name="commands" filePattern="${data}/commands/%d{yyyy-MM}/%d{yyyy-MM-dd}.log" append="true">
            <ThresholdFilter level="INFO"/>
            <TimeBasedTriggeringPolicy/>
        </RollingFile>
        <Routing name="commands">
            <Routes pattern="$${ctx:DYNAMIC_LOG}">
                <Route>
                    <File name="routing_log" append="true" fileName="${data}/commands/${ctx:DYNAMIC_LOG}.log">
                        <PatternLayout pattern="%d{ISO8601} %-5p %m%n"/>
                    </File>
                </Route>
            </Routes>
        </Routing>
    </Appenders>

    <!--
      Root/Console below is dead weight in the *running app* (quarkus:dev
      or prod): Quarkus's own launcher sets
      -Djava.util.logging.manager=org.jboss.logmanager.LogManager before
      anything logs, so org.jboss.slf4j:slf4j-jboss-logmanager wins the
      SLF4J-provider race there over this file's log4j-slf4j2-impl —
      confirmed by the running app's console using JBoss LogManager's
      format. application.properties' quarkus.log.console.format is that
      logging's real, active equivalent-settings config.

      But it's still load-bearing for test-scope code (e.g.
      CardDatabaseBuilder, tagged Builder — see CLAUDE.md): Maven Surefire's
      forked test JVM never sets that system property, so JBoss LogManager's
      binding fails there instead (confirmed: running a Builder-tagged test
      logs "ERROR: The LogManager accessed before the
      java.util.logging.manager system property was set... Results may be
      unexpected" from org.jboss.logmanager.JBossLoggerFinder). Log4j2's own
      binding is what actually carries plain SLF4J logging to the console in
      that context, so removing Root here would silence test-scope logging
      entirely rather than just being redundant with Quarkus's own config.

      net.deckserver.commands is unaffected either way — GameModel obtains it
      via org.apache.logging.log4j's native LogManager (not SLF4J)
      specifically for the per-game dynamic file routing below, which has no
      Quarkus-native equivalent. (Site-activity metrics used to have a sibling
      appender here; they moved to the metric_event table — see MetricsService.)
    -->
    <Loggers>
        <Logger name="net.deckserver.commands" level="INFO" additivity="false">
            <AppenderRef ref="commands"/>
            <AppenderRef ref="console" level="error"/>
        </Logger>
        <Root level="INFO">
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>

</Configuration>