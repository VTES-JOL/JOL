# Copy to `.keys` (git-ignored) and fill in. Sourced as the `env_file` for the
# app container in docker-compose.yml. Everything here is OPTIONAL for local
# development — the app starts without any of it:
#   - captcha: set ENABLE_CAPTCHA=false (see below) and skip the two keys
#   - Discord: integration is simply inactive when the token is unset
#   - web push: silently disabled when VAPID_PUBLIC_KEY / VAPID_KEY_FILE are unset
#   - secured card images: BASE_URL falls back to a public CDN; KEY_ID/KEY_FILE
#     only matter for CloudFront-signed URLs
# See the "Key Environment Variables" table in CLAUDE.md for full descriptions.

# --- Cloudflare Turnstile (historically named "recaptcha") ---
ENABLE_CAPTCHA=false
JOL_RECAPTCHA_KEY=
JOL_RECAPTCHA_SECRET=

# --- Discord integration ---
DISCORD_BOT_TOKEN=
DISCORD_PING_CHANNEL_ID=
DISCORD_API_VERSION=10

# --- Card image / tooltip asset origin ---
BASE_URL=https://static.deckserver.net
KEY_ID=
KEY_FILE=/data/private_key.pem

# --- Web push (VAPID) ---
# Public key is embedded client-side; private key is read from VAPID_KEY_FILE.
VAPID_PUBLIC_KEY=

# --- Database (docker-compose app container) ---
DB_USER=jol
DB_PASS=jol
DB_NAME=jol
PROD_DB_PASSWORD=jol
