<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>deckserver.net</groupId>
    <artifactId>jol-legacy</artifactId>
    <version>1.8.18-NB3</version>

    <packaging>jar</packaging>

    <properties>
        <JOL_DATA>${basedir}/src/test/resources</JOL_DATA>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.39.1</quarkus.platform.version>
    </properties>

    <dependencies>
        <!-- Quarkus: JPA/persistence layer (Phase 1 of the Quarkus migration —
             see quarkus-poc/FINDINGS.md). The Postgres driver/pool (Agroal)
             and Flyway are managed transitively by these extensions instead
             of the explicit postgresql/HikariCP/flyway-* dependencies this
             pom used to pin directly. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <!-- Quarkus: REST + WebSocket layer (Phase 3 — replaces Jersey/
             javax.ws.rs, javax.servlet, and javax.websocket outright, not
             alongside them; see quarkus-poc/FINDINGS.md for what changed
             porting SecurityFilter/AuthService/JolWebSocketEndpoint). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets</artifactId>
        </dependency>
        <!-- Quarkus: MicroProfile JWT RBAC. Provides the cookie-sourced
             JWT HttpAuthenticationMechanism that builds a SecurityIdentity
             (roles from the token's "groups" claim) so @RolesAllowed works,
             and pulls in jose4j, which TokenService uses directly to sign
             and verify the access token outside any Quarkus runtime context
             (service-level tests boot without one). Replaces the hand-rolled
             HMAC jjwt tokens in AuthService. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-jwt</artifactId>
        </dependency>
        <!-- Quarkus: frontend layer (Phase 4 — replaces frontend-maven-plugin/
             maven-war-plugin's manual react-dist staging, and Tomcat's
             RewriteValve-based SPA routing, entirely; see
             quarkus-poc/FINDINGS.md for the gotchas ported over from the POC). -->
        <dependency>
            <groupId>io.quarkiverse.quinoa</groupId>
            <artifactId>quarkus-quinoa</artifactId>
            <version>2.9.0</version>
        </dependency>
        <!--
          Explicit, version-unpinned (inherited from quarkus-bom's
          dependencyManagement, so it stays aligned with quarkus-hibernate-orm's
          expected version) — quarkus-hibernate-orm alone doesn't pull in
          hibernate-core's normal transitive dependency set (notably
          net.bytebuddy:byte-buddy), since Quarkus does its own build-time
          bytecode enhancement instead of needing it at runtime. But the test
          harness (JolServiceExtension) bootstraps its H2 EntityManagerFactory
          via plain Persistence.createEntityManagerFactory(...), entirely
          outside Quarkus's build-time pipeline — that needs a real runtime
          bytecode provider, which was missing without this: every EMF
          creation failed with "Unable to get public no-arg constructor" on
          Hibernate's BytecodeProviderImpl.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
        </dependency>
        <!--
          hibernate-core's own pom declares this as a normal runtime
          dependency, but quarkus-bom's dependencyManagement entry for
          hibernate-core carries an explicit <exclusion> for it (deliberate —
          Quarkus's build-time bytecode enhancement doesn't need it). That
          exclusion applies transitively regardless of which pom declares
          hibernate-core, so it has to be pulled back in directly here; a
          direct declaration isn't affected by another dependency's
          transitive exclusion. Version inherited from quarkus-bom.
        -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
        </dependency>

        <dependency>
            <groupId>com.vdurmont</groupId>
            <artifactId>emoji-java</artifactId>
            <version>5.1.1</version>
            <exclusions>
                <exclusion>
                    <groupId>org.json</groupId>
                    <artifactId>json</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!--
          commons-lang3, not commons-text: only StringUtils is used anywhere
          in this codebase (CommandParser, CardService, TournamentService,
          StatisticsResource, TournamentResource) — commons-text was never
          imported directly, it was just what pulled commons-lang3 in
          transitively.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.20.0</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.14.1</version>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.22.0</version>
        </dependency>

        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>4.5.14</version>
        </dependency>

        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpcore</artifactId>
            <version>4.4.16</version>
        </dependency>

        <dependency>
            <groupId>nl.martijndwars</groupId>
            <artifactId>web-push</artifactId>
            <version>5.1.2</version>
            <exclusions>
                <exclusion>
                    <groupId>org.bitbucket.b_c</groupId>
                    <artifactId>jose4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20260814</version>
        </dependency>

        <dependency>
            <groupId>org.bitbucket.b_c</groupId>
            <artifactId>jose4j</artifactId>
            <version>0.9.6</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.85</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
        </dependency>

        <dependency>
            <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
            <artifactId>owasp-java-html-sanitizer</artifactId>
            <version>20260313.1</version>
        </dependency>

        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.30.0</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.2</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.22.2</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-guava</artifactId>
            <version>2.22.2</version>
        </dependency>

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.7.1-jre</version>
        </dependency>

        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.4.0</version>
        </dependency>

        <!--
          GameModel's METRICS/COMMANDS loggers call
          org.apache.logging.log4j.LogManager directly for log4j2.xml's
          per-game dynamic file routing (see its class comment) — this used
          to come in transitively via log4j-slf4j2-impl (removed: it made
          log4j2 needlessly compete with org.jboss.slf4j:slf4j-jboss-
          logmanager for the SLF4J-provider slot, which nothing actually
          wanted log4j2 to win). Declared directly now that nothing else
          pulls it in.
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.2.4</version>
        </dependency>

        <dependency>
            <groupId>io.azam.ulidj</groupId>
            <artifactId>ulidj</artifactId>
            <version>1.1.0</version>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudfront</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit-pioneer</groupId>
            <artifactId>junit-pioneer</artifactId>
            <version>2.3.0</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>7.34.7</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>7.34.7</version>
            <scope>test</scope>
        </dependency>

        <!-- Required by Hibernate's persistence.xml JAXB parsing at boot -->
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>

        <!--
          Pinned explicitly: jackson-module-jaxb-annotations pulls in the old
          javax.activation-namespaced 1.2.2, which shadows the jakarta.activation
          namespace jaxb-runtime needs at boot (NoClassDefFoundError: jakarta/activation/DataSource).
        -->
        <dependency>
            <groupId>jakarta.activation</groupId>
            <artifactId>jakarta.activation-api</artifactId>
            <version>2.1.4</version>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>jol</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <!--
                  Excludes the binary dev-keystore.p12 from the resources
                  block's text-based filtering above (which otherwise
                  corrupts it — MalformedInputException on the raw bytes).
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <nonFilteredFileExtensions>
                        <nonFilteredFileExtension>p12</nonFilteredFileExtension>
                    </nonFilteredFileExtensions>
                </configuration>
            </plugin>
            <plugin>
                <!--
                  Quarkus build-time augmentation (extension processing, CDI
                  bean discovery, etc.) and quarkus:dev/quarkus:test. Inert
                  for plain `mvn test`/`mvn compile` — see quarkus-poc/'s
                  identical binding for the pattern this mirrors.
                -->
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>21</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <!--
                      Makes JBoss LogManager (the SLF4J provider that wins
                      on this classpath — see log4j2.xml's Root/Loggers
                      comment) the active java.util.logging.LogManager in
                      Surefire's forked JVM, same as Quarkus's own
                      dev/runtime launcher does for the real app. Needed
                      for net.deckserver.testsupport.TestLoggingActivator
                      (a JUnit TestExecutionListener, auto-registered via
                      META-INF/services) to reach the right LogContext —
                      see its class comment for why plain SLF4J logging is
                      otherwise silently dropped in test scope.
                    -->
                    <argLine>@{argLine} --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED
                        -Djava.util.logging.manager=org.jboss.logmanager.LogManager
                    </argLine>
                    <excludedGroups>Builder</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- Imported before quarkus-bom so it keeps winning on the
                 JUnit GAs it manages (Quarkus's own BOM manages a newer
                 JUnit major version — out of scope to pull in incidentally
                 during this phase, e.g. junit-pioneer 2.3.0's compatibility
                 with it is unverified). Import order only matters where two
                 imported BOMs manage the exact same GA; this doesn't affect
                 quarkus-bom winning on Hibernate ORM below, since junit-bom
                 doesn't touch those coordinates at all. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.14.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- This now owns the Hibernate ORM version that
                 quarkus-hibernate-orm's build-time processing expects — the
                 old explicit org.hibernate.orm:hibernate-platform BOM import
                 was removed for exactly this reason, since pinning a
                 different Hibernate ORM version than Quarkus's extension
                 expects breaks its build-time bytecode enhancement. -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>2.26.1</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>

            <dependency>
                <groupId>org.hamcrest</groupId>
                <artifactId>hamcrest</artifactId>
                <version>3.0</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.54.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>

    </dependencyManagement>

    <profiles>
        <profile>
            <id>local</id>
        </profile>
    </profiles>

</project>
